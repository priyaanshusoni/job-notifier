// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String // bcrypt hashed, never plain text
  isOnboarded  Boolean  @default(false)
  resumeText   String? // AES-256-GCM encrypted, optional — used for resume-aware ranking
  resumeSkills String[] @default([]) // skills extracted from resume via Gemini
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  preference     Preference?
  telegramConfig TelegramConfig?
  userJobs       UserJob[]
  pipelineRuns   PipelineRun[]
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Preference {
  id             Int      @id @default(autoincrement())
  roles          String[] // ["Full Stack Developer", "React Developer"]
  skills         String[] // nice-to-have skills
  mustHaveSkills String[] @default([]) // job is disqualified if none of these appear
  location       String[] // ["Jaipur", "Remote", "Bangalore"]
  workMode       String   @default("any") // any | remote | hybrid | onsite
  minSalary      Int // annual INR
  experience     String // "1-3 years"
  metaInfo       String? // "product companies, remote, startups"

  // Customization
  excludedKeywords  String[] @default([]) // disqualify if present in title/description
  excludedCompanies String[] @default([])
  minScore          Int      @default(75) // alert threshold 0-100
  maxAlertsPerRun   Int      @default(10)
  digestMode        Boolean  @default(true) // one combined Telegram message vs per-job
  searchRecency     String   @default("today") // today | 3days | week | month

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramConfig {
  id        Int      @id @default(autoincrement())
  botToken  String // AES-256-GCM encrypted before storing
  chatId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Canonical job record — fetched once, shared across users
model Job {
  id           Int       @id @default(autoincrement())
  externalId   String    @unique // job ID from the source API
  title        String
  company      String
  location     String
  salaryRaw    String? // free-text salary as returned by source
  salaryMin    Int? // numeric, as returned by source
  salaryMax    Int?
  salaryPeriod String? // YEAR | MONTH | HOUR
  isRemote     Boolean   @default(false)
  description  String
  source       String // "LinkedIn", "Indeed", "Naukri"
  applyLink    String
  postedAt     DateTime?
  fetchedAt    DateTime  @default(now())

  userJobs UserJob[]
}

// Per-user evaluation state for a job. Every evaluated job is stored,
// not only the ones that were notified.
model UserJob {
  id             Int       @id @default(autoincrement())
  score          Int // 0-100
  reason         String // short user-facing explanation
  scoreBreakdown Json? // { roleFit, skills, location, salary, experience }
  decision       String // matched | below_threshold | prefiltered
  status         String    @default("new") // new | saved | dismissed | applied | not_relevant
  notified       Boolean   @default(false)
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  Int
  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

// Pipeline run history — powers the dashboard status panel and acts as a
// lock against concurrent runs.
model PipelineRun {
  id         Int       @id @default(autoincrement())
  trigger    String // cron | manual
  status     String    @default("running") // running | success | error
  stats      Json? // { fetched, new, evaluated, matched, notified }
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Relations
  userId Int? // null for full cron runs
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startedAt])
}
